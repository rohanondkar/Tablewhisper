  "skills": [
    { "id": "acrobatics", "name": "Acrobatics", "ability": "dexterity", "examples": ["Stay upright on a tossing deck", "Tumble through enemies", "Perform a stunt"] },
    { "id": "animal_handling", "name": "Animal Handling", "ability": "wisdom", "examples": ["Calm a mount", "Intuit an animal's intentions"] },
    { "id": "arcana", "name": "Arcana", "ability": "intelligence", "examples": ["Recall lore about spells or magic items", "Identify a magical effect"] },
    { "id": "athletics", "name": "Athletics", "ability": "strength", "examples": ["Climb a sheer cliff", "Swim against a current", "Grapple"] },
    { "id": "deception", "name": "Deception", "ability": "charisma", "examples": ["Tell a convincing lie", "Wear a disguise socially"] },
    { "id": "history", "name": "History", "ability": "intelligence", "examples": ["Recall historical events", "Identify a legendary figure"] },
    { "id": "insight", "name": "Insight", "ability": "wisdom", "examples": ["Sense a creature's motives", "Detect a lie"] },
