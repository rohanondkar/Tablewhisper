  "check_guidance": [
    {
      "keywords": ["sneak", "sneaks", "sneaking", "hide", "hides", "stealth", "quietly", "unseen", "sneak past", "sneaks past"],
      "check_type": "skill",
      "skill": "stealth",
      "ability": "dexterity",
      "suggested_dc": 15,
      "notes": "Contested by passive Perception or active Perception if searching."
    },
    {
      "keywords": ["climb", "swim", "jump", "grapple", "grapples", "shove", "shoves", "lift", "break down", "force open"],
      "check_type": "skill",
      "skill": "athletics",
      "ability": "strength",
      "suggested_dc": 15,
      "notes": "Use Athletics for force-based movement and grappling. Grapple/shove are often contested by Athletics or Acrobatics."
    },
    {
      "keywords": ["balance", "tumble", "flip", "land on feet", "tightrope"],
      "check_type": "skill",
      "skill": "acrobatics",
      "ability": "dexterity",
      "suggested_dc": 15,
      "notes": "Prefer Acrobatics over Athletics when agility matters more than power."
    },
    {
      "keywords": ["lie", "lies", "bluff", "bluffs", "disguise", "deceive", "deceives", "feint socially", "pretend"],
