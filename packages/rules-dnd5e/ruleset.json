  "saves": [
    { "id": "strength", "ability": "strength", "examples": ["Resist being pushed or knocked prone by force"] },
    { "id": "dexterity", "ability": "dexterity", "examples": ["Dodge a fireball or trap", "Reduce falling damage via agility"] },
    { "id": "constitution", "ability": "constitution", "examples": ["Resist poison", "Maintain concentration"] },
    { "id": "intelligence", "ability": "intelligence", "examples": ["Resist psychic probing or illusions tied to intellect"] },
