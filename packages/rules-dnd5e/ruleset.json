    { "id": "stealth", "name": "Stealth", "ability": "dexterity", "examples": ["Hide from enemies", "Sneak past a sentry"] },
    { "id": "survival", "name": "Survival", "ability": "wisdom", "examples": ["Track creatures", "Forage", "Avoid natural hazards"] }
