  "abilities": [
    {
      "id": "strength",
      "abbr": "STR",
      "name": "Strength",
      "used_for": [
        "Athletic feats of power",
        "Breaking, lifting, forcing open",
        "Jumping and climbing when contested by force"
      ]
    },
    {
      "id": "dexterity",
      "abbr": "DEX",
      "name": "Dexterity",
      "used_for": [
        "Balance, agility, reflexes",
        "Stealth and sleight of hand",
        "Initiative, ranged attacks, AC (light/medium)"
      ]
    },
    {
      "id": "constitution",
      "abbr": "CON",
      "name": "Constitution",
      "used_for": [
        "Endurance and stamina",
        "Holding breath, resisting poison",
        "Concentration saves for spells"
      ]
    },
    {
      "id": "intelligence",
      "abbr": "INT",
      "name": "Intelligence",
      "used_for": [
        "Recall lore and reason through puzzles",
        "Investigate clues and analyze evidence"
      ]
    },
    {
      "id": "wisdom",
      "abbr": "WIS",
      "name": "Wisdom",
      "used_for": [
        "Notice and intuition",
