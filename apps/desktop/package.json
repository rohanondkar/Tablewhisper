{
  "name": "dm-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:ui": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "konva": "^10.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  }
}
